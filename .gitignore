/bin/
/hackathonkit-mcp
/hackathonkit-demo-api
/hackathonkit-ctl
/hackathonkit-rehearse
*.exe
.env
.env.*
!/.env.example
/logs/
node_modules/
__pycache__/
*.pyc
.coverage
coverage/
htmlcov/
.venv/
/tmp/
*.log
plugins/hackathonkit/.mcp.json
# All runtime/generated state under data/ is ignored, except the committed
# sample corpus and dataset. New generated subdirectories are covered
# automatically instead of needing a hand-added entry.
data/*/
!data/input/
!data/fly/
.agents/skills/
.claude/skills/
.opencode/commands/
.claude/commands/
# Generated at install time by scripts/write-install-state.sh / setup-resources.sh;
# never committed. Regenerate with `sh scripts/write-install-state.sh . full binary`
# and `sh scripts/setup-resources.sh`.
configs/install-state.json
configs/resources.json
# All generated eval artifact kinds are ignored (only the tracked top-level
# README stays). New kinds are covered automatically.
evals/*/
!evals/README.md
# Legacy alias for data/judge-bundles/ (kept for older checkouts).
judge-bundle/
