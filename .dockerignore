.github
.git
.gitignore
# Match .env at any depth: patterns without `**/` are anchored at the context
# root, so nested secret files would otherwise be copied into the build.
**/.env*
!**/.env.example
# Generated/runtime state and local toolchains: never send these to the daemon.
bin
data
logs
evals
**/logs
**/evals
.agents/skills
.claude/skills
.opencode/commands
.claude/commands
node_modules
**/node_modules
__pycache__
**/__pycache__
**/*.pyc
.venv
**/.venv
coverage
**/coverage
htmlcov
**/htmlcov
/tmp
**/*.log
# Generated install state (never committed).
configs/install-state.json
configs/resources.json
plugins/hackathonkit/.mcp.json
# Drop documentation from the build context; no Go package embeds markdown
# (the embedded assets are cmd/demo-api/static/*.html|js), so only the root
# README and runtime skill documents are kept.
**/*.md
!README.md
!plugins/hackathonkit/skills/**/*.md

# Credentials and host build outputs are never build inputs.
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.exe
**/.DS_Store
**/.coverage
hackathonkit-mcp
hackathonkit-ctl
hackathonkit-demo-api
hackathonkit-rehearse
/demo-api
/fly-bench
/fly-train
docs/ocr-artifacts
