{
  "name": "hackathonkit",
  "version": "0.11.0",
  "description": "Hackathon Agent Kit: local MCP capability layer, skills, evaluation and learning for hackathon builds.",
  "author": {
    "name": "Hackathon Agent Kit"
  },
  "keywords": [
    "mcp",
    "skills",
    "evaluation",
    "hackathon",
    "telemetry",
    "documents"
  ],
  "skills": [
    "./plugins/hackathonkit/skills"
  ],
  "mcpServers": {
    "hackathonkit": {
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "run",
        "--rm",
        "-T",
        "hackathonkit-mcp"
      ]
    }
  }
}
