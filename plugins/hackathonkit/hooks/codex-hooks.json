{
  "description": "Hackathon Agent Kit session lifecycle hooks. Node resolves the installed plugin path from PLUGIN_ROOT on all platforms.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','hooks.js'))\" -- hooks.js session-start",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','hooks.js'))\" -- hooks.js tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','hooks.js'))\" -- hooks.js session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
