# Normalise line endings to LF in the repository; the working tree keeps LF
# except for the Windows-native formats listed below (which force CRLF).
* text=auto eol=lf

# Binary content: never normalise or diff as text. Listed explicitly because the
# text=auto NUL-byte heuristic can misfire on small binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.tiff binary
*.tif binary
*.avif binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
# OBJ can also be a compiled object, and STL has a binary representation.
# glTF JSON is text; GLB is its binary container.
*.stl binary
*.obj binary
*.glb binary
*.gltf text eol=lf
*.mp4 binary
*.m4a binary
*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary
# Compiled artifacts / archives.
*.exe binary
*.dll binary
*.so binary
*.so.* binary
*.dylib binary
*.dylib.* binary
*.a binary
*.o binary
*.jar binary
*.class binary
*.wasm binary
*.pyc binary

# The global `* text=auto eol=lf` already normalises text to LF, so only the
# CRLF overrides below need to be listed explicitly.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.ps1xml text eol=crlf
*.vbs text eol=crlf
*.wsf text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# Windows-native project/registry files must keep CRLF.
*.sln text eol=crlf
*.csproj text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
# Registry exports can contain UTF-16 data. Preserve their original bytes.
*.reg -text
